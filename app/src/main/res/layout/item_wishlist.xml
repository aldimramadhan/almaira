<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_wishlist_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginBottom="12dp"
    android:outlineAmbientShadowColor="#0D463032"
    android:outlineSpotShadowColor="#14463032"
    app:cardBackgroundColor="#FFFFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#FFF0EAE7"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Checkbox Button Squircle Target -->
        <FrameLayout
            android:id="@+id/btn_toggle_checkbox"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iv_checkbox"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_checkbox_unchecked" />
        </FrameLayout>

        <!-- Main Info Container -->
        <LinearLayout
            android:id="@+id/layout_content_click"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Category & Creator Badges -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_category_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_category"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3.5dp"
                    android:text="✈️ Travel"
                    android:textColor="#FFD45863"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_added_by"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:text="oleh Aldi ♡"
                    android:textColor="#FF9E8C8B"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Wishlist Title -->
            <TextView
                android:id="@+id/tv_wishlist_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:letterSpacing="-0.01"
                android:lineSpacingMultiplier="1.2"
                android:text="Umrah ke Makkah &amp; Madinah"
                android:textColor="#FF2B1D1D"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <!-- Subtitle / Target / Completed Date -->
            <TextView
                android:id="@+id/tv_wishlist_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.5dp"
                android:lineSpacingMultiplier="1.1"
                android:text="Target: Akhir Tahun 2026"
                android:textColor="#FF786564"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Delete Action Button -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/btn_delete_item"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Hapus"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_trash"
                app:tint="#FFB8A5A4" />
        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
